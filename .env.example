# Keep every credential private. Never commit a populated .env file.
# Generate random values locally; do not paste them into chat.
VAULT_SETUP_KEY=
APP_PASSWORD=
SECRET_KEY=

APP_TITLE=Personal Vault
APP_ENV=development
COOKIE_SECURE=false
SESSION_MAX_AGE=86400

# GitHub only or GitHub + Google Drive: set all 3 together.
# GitHub only: leave Google Drive OAuth variables blank.
# Drive only: leave all 3 GitHub variables blank and set APP_PASSWORD.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Google Drive only or GitHub + Google Drive: set both together.
GOOGLE_OAUTH_CLIENT_B64=
GOOGLE_OAUTH_TOKEN_B64=
GOOGLE_DRIVE_FOLDER_ID=

# Keep this path the same as the Telegram bot when sharing the same vault.
VAULT_DATA_DIR=vault-data
MAX_RECORDS_PER_SHARD=250
MAX_UPLOAD_MB=25
PORT=8000
LOG_LEVEL=INFO
