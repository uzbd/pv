# Local development only. Render Blueprint generates SECRET_KEY automatically.
# Keep GitHub credentials on the server. The browser never asks for the PAT.
# First-run setup uses a separate one-time secret; generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_SETUP_KEY=
# APP_PASSWORD is optional for local legacy/Drive-only deployments.
APP_PASSWORD=

# Generate with: python scripts/generate_secret.py
# Keep this stable between restarts so browser sessions remain valid.
SECRET_KEY=
APP_TITLE=Personal Vault
APP_ENV=development
COOKIE_SECURE=false
SESSION_MAX_AGE=86400

# GitHub is the recommended first-run storage. Set all 3 together.
# Fine-grained PAT: selected repository -> Contents: Read and write.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional advanced feature: configure both OAuth values to enable Google Drive.
GOOGLE_OAUTH_CLIENT_B64=
GOOGLE_OAUTH_TOKEN_B64=
GOOGLE_DRIVE_FOLDER_ID=

# Reuse the existing Telegram Personal Vault data directory to read old records.
VAULT_DATA_DIR=vault-data
MAX_RECORDS_PER_SHARD=250
MAX_UPLOAD_MB=25
PORT=8000
LOG_LEVEL=INFO
